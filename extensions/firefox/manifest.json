{
  "manifest_version": 3,
  "name": "Parul eLearning PDF Download",
  "version": "1.0.0",
  "description": "An independent, privacy-first PDF download utility for Parul University eLearning.",
  "author": "Ayush Meel",
  "homepage_url": "https://github.com/meel-ayush/parul-elearning-pdf-download",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://elearning.paruluniversity.ac.in/*",
    "https://*.digitaloceanspaces.com/*",
    "https://*.edorer.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "parul-elearning-pdf-download@meel-ayush.github.io",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://elearning.paruluniversity.ac.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "service-worker.js"
    ]
  },
  "action": {
    "default_title": "Parul eLearning PDF Download"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
